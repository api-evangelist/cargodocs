  "info": {
    "_postman_id": "eaa3b693-16f5-433c-9515-aa6a8d2c4a05",
    "name": "CargoDocs Customer Data/Docs Common Exchange API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The CargoDocs Customer Data/Docs API enables exporters to draft trade and shipping documents, including tanker, bulker, or barge bills of lading from data imported from an ERP system, CTRM, TMS, WMS, etc. It also enables any party using CargoDocs to download copy docs and data to automate various back-office steps.\n\nContact Support:\n Name: ICE Digital Trade (essDOCS)",
      "type": "text/plain"
    }
  }
